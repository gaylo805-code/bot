# --- Dich (doi provider qua TRANSLATE_PROVIDER=google|llm, mac dinh google FREE) ---
TRANSLATE_PROVIDER=google
# LLM providers (chi can khi TRANSLATE_PROVIDER=llm) ---
# Vi du: gemini/gemini-2.0-flash | gpt-4o-mini | deepseek/deepseek-chat | ollama/llama3.1
LLM_MODEL=gemini/gemini-2.0-flash
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Lip-sync: Wav2Lip (mouth) + GFPGAN (face). Setup: ./scripts/setup_lipsync.sh ---
WAV2LIP_ENABLED=true
WAV2LIP_DIR=./third_party/Wav2Lip
WAV2LIP_CHECKPOINT=./models/wav2lip_gan.pth
WAV2LIP_STATIC=false
GFPGAN_ENABLED=true
GFPGAN_PATH=./models/GFPGANv1.4.pth

# --- TTS (doi provider qua TTS_PROVIDER=edge|vieneu, mac dinh edge FREE) ---
TTS_PROVIDER=edge
EDGE_VOICE=vi-VN-HoaiMyNeural
EDGE_RATE=+0%
# VieNeu TTS (endpoint tuong thich OpenAI) - chi can khi TTS_PROVIDER=vieneu
VIENEU_API_KEY=
VIENEU_BASE_URL=https://api.vieneu.io/api/v1
VIENEU_VOICE_ID=vieneu-female-01
VIENEU_MODEL=vieneu-v4

# --- Whisper ASR ---
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_BEAM_SIZE=5

# --- Storage / limits ---
STORAGE_PATH=./storage
DATABASE_URL=sqlite:///./storage/dubbing.db
REDIS_URL=redis://redis:6379/0
MAX_UPLOAD_MB=500
CLEANUP_SOURCE_AFTER_DONE=false

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://api:8000
API_KEY=

# --- Cloudflare Quick Tunnel ---
# Tự tạo https://xxxx.trycloudflare.com khi PUBLIC_HOSTNAME để trống.
QUICK_TUNNEL_ENABLED=true
# Dùng hostname cố định nếu có; khi đặt giá trị này Quick Tunnel sẽ không chạy.
PUBLIC_HOSTNAME=
CLOUDFLARE_TUNNEL_TOKEN=

# --- Discord Bot (VIP) ---
DISCORD_BOT_TOKEN=
# Optional: guild ID de sync slash command tu'c thi khi dev (bo trong = global, hien sau ~1h)
DISCORD_GUILD_ID=
DISCORD_MAX_FILE_MB=25
DISCORD_MAX_CONCURRENT_PER_USER=2
DISCORD_POLL_INTERVAL=5.0
DISCORD_DUB_COOLDOWN_S=10
DISCORD_TRACK_TIMEOUT_S=7200
